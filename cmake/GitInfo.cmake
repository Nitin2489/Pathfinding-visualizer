# Writes OUT_FILE with the git commit and dirty state of SRC_DIR.
# Run at every build (cmake -P) so the values describe the sources that were
# actually compiled. The file is rewritten only when its content changes.
set(commit "unknown")
set(dirty "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
                  WORKING_DIRECTORY "${SRC_DIR}" RESULT_VARIABLE rc
                  OUTPUT_VARIABLE out OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(rc EQUAL 0 AND out)
    set(commit "${out}")
    # Untracked files count as dirty: they may be compiled into the binary.
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain
                    WORKING_DIRECTORY "${SRC_DIR}" RESULT_VARIABLE rc
                    OUTPUT_VARIABLE status ERROR_QUIET)
    if(rc EQUAL 0)
      if(status STREQUAL "")
        set(dirty "false")
      else()
        set(dirty "true")
      endif()
    endif()
  endif()
endif()
set(content "// Generated by cmake/GitInfo.cmake. Do not edit.\n#pragma once\n#define PATHFINDING_GIT_COMMIT \"${commit}\"\n#define PATHFINDING_GIT_DIRTY \"${dirty}\"\n")
set(old "")
if(EXISTS "${OUT_FILE}")
  file(READ "${OUT_FILE}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT_FILE}" "${content}")
endif()
